# ==========================================================
# AI-AGENT-CS - SIGE RAG AI Agent
# ==========================================================

# ==========================================================
# OLLAMA CONFIGURATION
# ==========================================================

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Chat model (use the model you downloaded, e.g., qwen2.5:7b-instruct)
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embedding model
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# ==========================================================
# RAG SETTINGS
# ==========================================================

# Number of chunks retrieved per query
TOP_K=4

LLM_TEMPERATURE=0.3
# Minimum similarity score
SIMILARITY_THRESHOLD=0.30

# Telegram Lead Notifications
TELEGRAM_BOT_TOKEN=8745777169:AAGuiJAbGDeUB-6ozbAbLrtp9uxuH38GlNU
TELEGRAM_CHAT_ID=7196375295,8641056470,7318134903

# Escalation confidence threshold
CONFIDENCE_THRESHOLD=0.75

# Maximum tokens per LLM response
MAX_OUTPUT_TOKENS=512


# ==========================================================
# CHUNKING SETTINGS
# ==========================================================

# Token size per chunk
CHUNK_SIZE=500

# Overlap between chunks
CHUNK_OVERLAP=80


# ==========================================================
# VECTOR STORE SETTINGS
# ==========================================================

# Vector store directory
VECTOR_STORE_PATH=data/vector_store/

# FAISS index filename
FAISS_INDEX_FILE=faiss_index.index

# Metadata storage file
