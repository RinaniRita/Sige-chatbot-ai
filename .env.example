# ==========================================================
# AI-AGENT-CS - SIGE RAG AI Agent
# ==========================================================

# ==========================================================
# OLLAMA CONFIGURATION
# ==========================================================

# Ollama server URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Chat model (e.g., qwen2.5:7b-instruct)
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embedding model
OLLAMA_EMBEDDING_MODEL=nomic-embed-text


# ==========================================================
# RAG SETTINGS
# ==========================================================

# Number of chunks retrieved per query
TOP_K=4

LLM_TEMPERATURE=0.3
# Minimum similarity score
SIMILARITY_THRESHOLD=0.30

# Telegram Lead Notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=chat_id1,chat_id2

# Escalation confidence threshold
CONFIDENCE_THRESHOLD=0.75

# Maximum tokens per LLM response
MAX_OUTPUT_TOKENS=512


# ==========================================================
# CHUNKING SETTINGS
# ==========================================================

# Token size per chunk
CHUNK_SIZE=500

# Overlap between chunks
CHUNK_OVERLAP=80


# ==========================================================
# VECTOR STORE SETTINGS
# ==========================================================

# Vector store directory
VECTOR_STORE_PATH=data/vector_store/

# FAISS index filename
FAISS_INDEX_FILE=faiss_index.index

# Metadata storage file
METADATA_FILE=metadata.json


# ==========================================================
# APPLICATION SETTINGS
# ==========================================================

APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO

# Facebook Messenger Configuration
FB_PAGE_ACCESS_TOKEN=your_page_access_token
FB_VERIFY_TOKEN=your_verify_token
FB_APP_SECRET=your_app_secret

# PSIDs that bypass blocking (e.g. admin testers)
WHITELIST_PSIDS=psid1,psid2

# App IDs that represent bots/automation (comma separated)
# 921841513979535: SIGE AI Bot
BOT_APP_IDS=921841513979535

# Backend URL (e.g. Ngrok)
API_BASE_URL=https://your-ngrok-url.ngrok-free.app


# ==========================================================
# GOOGLE SHEETS INTEGRATION (SIGE)
# ==========================================================
# The ID from the spreadsheet URL
SIGE_LEADS_SHEET_ID=your_sheet_id
HOT_LEADS_SHEET_NAME=hot_lead_911
HOT_LEADS_SHEET_GID=your_sheet_gid
# The Webhook URL from the Apps Script deployment
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/.../exec